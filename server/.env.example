# Server
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/jobmansion

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Client origin for CORS
CLIENT_URL=http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail SMTP or Resend)
EMAIL_USER=
EMAIL_PASS=

# Initial Admin Credentials (for seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@jobmansion.com
ADMIN_PASSWORD=Admin@12345
